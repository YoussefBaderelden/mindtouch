{
  "version": 2,
  "name": "mindtouch",
  "buildCommand": "",
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/health", "destination": "/api/health" },
    { "source": "/v1/phone/actions", "destination": "/api/phone/actions" },
    { "source": "/v1/phone/phones", "destination": "/api/phone/phones" },
    { "source": "/v1/phone/register", "destination": "/api/phone/register" },
    { "source": "/v1/phone/poll", "destination": "/api/phone/poll" },
    { "source": "/v1/phone/command", "destination": "/api/phone/command" },
    { "source": "/v1/phone/direction", "destination": "/api/phone/direction" },
    { "source": "/v1/phone/ack", "destination": "/api/phone/ack" },
    { "source": "/v1/phone/logs", "destination": "/api/phone/logs" },
    { "source": "/v1/auth/register", "destination": "/api/auth/register" },
    { "source": "/v1/auth/login", "destination": "/api/auth/login" },
    { "source": "/v1/auth/me", "destination": "/api/auth/me" },
    { "source": "/api/auth/register", "destination": "/api/auth/register" },
    { "source": "/api/auth/login", "destination": "/api/auth/login" },
    { "source": "/api/auth/me", "destination": "/api/auth/me" }
  ]
}
